DATABASE_URL=postgresql://atabey:atabey@localhost:5433/atabey
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=atabey/#

SECRET_KEY=supersecretkey_for_dev_only
ALGORITHM=HS256
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin_pass

# ── Modo de acceso ───────────────────────────────────────────────────────────
# REQUIRE_LOGIN=false  -> el dashboard entra sin credenciales (modo pruebas
#                         con sensores formales y despliegue publico).
#                         El sistema de roles NO se desactiva: DEFAULT_ROL
#                         sigue decidiendo que datos se ven.
# REQUIRE_LOGIN=true   -> login obligatorio (default, recomendado en produccion).
REQUIRE_LOGIN=true
DEFAULT_ROL=administrador
DEFAULT_USERNAME=anonimo
